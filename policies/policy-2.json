{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EC2OnResourcesByTags",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeVpcAttribute",
                "ec2:DescribeVpcEndpointServices",
                "ec2:DeleteVpc",
                "ec2:ModifyVpcAttribute",
                "ec2:ModifyVpcEndpoint",
                "ec2:DeleteSecurityGroup",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupEgress",
                "ec2:DeleteSubnet",
                "ec2:ModifySubnetAttribute",
                "ec2:ReleaseAddress",
                "ec2:AttachInternetGateway",
                "ec2:DeleteInternetGateway",
                "ec2:DetachInternetGateway",
                "ec2:DeleteRouteTable",
                "ec2:CreateRoute",
                "ec2:AssociateRouteTable",
                "ec2:DisassociateRouteTable",
                "ec2:DeleteVpcEndpoints",
                "ec2:DeleteNatGateway",
                "ec2:DeleteLaunchTemplate",
                "ec2:CreateLaunchTemplateVersion",
                "ec2:DeleteLaunchTemplateVersions"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:vpc/*",
                "arn:aws:ec2:{region}:{account}:security-group/*",
                "arn:aws:ec2:{region}:{account}:subnet/*",
                "arn:aws:ec2:{region}:{account}:elastic-ip/*",
                "arn:aws:ec2:{region}:{account}:internet-gateway/*",
                "arn:aws:ec2:{region}:{account}:route-table/*",
                "arn:aws:ec2:{region}:{account}:vpc-endpoint/*",
                "arn:aws:ec2:{region}:{account}:natgateway/*",
                "arn:aws:ec2:{region}:{account}:launch-template/*"
            ]
        },
        {
            "Sid": "DisassociateAddress",
            "Effect": "Allow",
            "Action": [
                "ec2:DisassociateAddress"
            ],
            "Resource": "arn:aws:ec2:{region}:{account}:*/*"
        },
        {
            "Sid": "E3SServerTermination",
            "Effect": "Allow",
            "Action": [
                "ec2:TerminateInstances"
            ],
            "Resource": "arn:aws:ec2:{region}:{account}:instance/*"
        },
        {
            "Sid": "EC2CreateWithTag",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateVpc",
                "ec2:AllocateAddress",
                "ec2:CreateInternetGateway",
                "ec2:CreateLaunchTemplate"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:vpc/*",
                "arn:aws:ec2:{region}:{account}:elastic-ip/*",
                "arn:aws:ec2:{region}:{account}:internet-gateway/*",
                "arn:aws:ec2:{region}:{account}:launch-template/*"
            ]
        },
        {
            "Sid": "EC2VpcWithTag",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateSecurityGroup",
                "ec2:ModifySecurityGroupRules",
                "ec2:CreateSubnet",
                "ec2:CreateRouteTable"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:security-group/*",
                "arn:aws:ec2:{region}:{account}:security-group-rule/*",
                "arn:aws:ec2:{region}:{account}:subnet/*",
                "arn:aws:ec2:{region}:{account}:route-table/*"
            ]
        },
        {
            "Sid": "EC2VpcByTag",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateSecurityGroup",
                "ec2:CreateSubnet",
                "ec2:CreateRouteTable"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:vpc/*"
            ]
        },
        {
            "Sid": "SGRuleWithTag",
            "Effect": "Allow",
            "Action": [
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:security-group-rule/*"
            ]
        },
        {
            "Sid": "SGRuleByTag",
            "Effect": "Allow",
            "Action": [
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:security-group/*"
            ]
        },
        {
            "Sid": "Nat",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateNatGateway"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:natgateway/*"
            ]
        },
        {
            "Sid": "NatByTags",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateNatGateway"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:subnet/*",
                "arn:aws:ec2:{region}:{account}:elastic-ip/*"
            ]
        },
        {
            "Sid": "VpcEndpointWithTags",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateVpcEndpoint"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:vpc-endpoint/*"
            ]
        },
        {
            "Sid": "VpcEndpointByTags",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateVpcEndpoint"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:vpc/*",
                "arn:aws:ec2:{region}:{account}:subnet/*",
                "arn:aws:ec2:{region}:{account}:route-table/*",
                "arn:aws:ec2:{region}:{account}:security-group/*"
            ]
        },
        {
            "Sid": "EC2RunInstances",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances"
            ],
            "Resource": [
                "arn:aws:ec2:{region}::image/*",
                "arn:aws:ec2:{region}:{account}:instance/*",
                "arn:aws:ec2:{region}:{account}:volume/*",
                "arn:aws:ec2:{region}:{account}:network-interface/*"
            ]
        },
        {
            "Sid": "EC2RunInstancesByTags",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances"
            ],
            "Resource": [
                "arn:aws:ec2:{region}:{account}:security-group/*",
                "arn:aws:ec2:{region}:{account}:subnet/*",
                "arn:aws:ec2:{region}:{account}:launch-template/*"
            ]
        }
    ]
}