profile = "terraform"

resources_prefix         = "e3s-test"
region                   = "us-east-1"
e3s_server_instance_type = "m5n.large"

s3_bucket = {
  exists = false
  name   = "e3s-test-assets"
  region = "us-east-1"
}

vpc_id         = "vpc-1234"
vpc_cidr_block = "172.31.0.0/16"

enable_cloudwatch = true
cert = "arn:aws:acm:us-east-1:1234:certificate/1234"

remote_db = {
  username = "postgres"
  pass     = "1234"
}

instance_types = [
  {
    weight        = 1
    instance_type = "c5a.2xlarge"
  }
]

spot_price = {
  linux   = "1"
  windows = "1"
}

zebrunner = {
  host = "https://zebrunner.com"
  user = "user"
  pass = "pass"
}

# List of CIDR blocks allowed to access the e3s server (ALB and router ports)
# Maximum 165 CIDR blocks (hard limit: 55 rules per security group × 3 security groups)
# Example: ["203.0.113.0/24", "198.51.100.50/32"]
allowed_e3s_server_cidr_blocks = ["0.0.0.0/0"]

# AWS Secrets Manager secret name for SNS topic ARNs
notification_sns_topic_secret_name = "esg/automatic-update/sns-topics"

# SNS Topic names
notification_sns_topic_success = "build-success"
notification_sns_topic_failure = "build-failure"

# Email subscriptions for success notifications
notification_email_success = [
  "vadym.spitsyn.solvd@gmail.com"
]

# Email subscriptions for failure notifications (can be the same or different from success)
notification_email_failure = [
  "vspitsyn@solvd.com"
]
